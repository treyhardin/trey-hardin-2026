---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import ContactDrawer from '../components/ContactDrawer.astro';
import { getHeader, getFooter } from '../lib/sanity';
import { VisualEditingComponent as VisualEditing } from '@sanity/astro/visual-editing/component';
import { perspectiveCookieName } from '@sanity/preview-url-secret/constants';

const enableVisualEditing = import.meta.env.PUBLIC_SANITY_VISUAL_EDITING_ENABLED === 'true';
const header = await getHeader();
const footer = await getFooter();

// Meta tag values (kept as constants to avoid [object Object] from <slot> in attribute expressions)
const siteTitle = 'Trey Hardin — Design Lead';
const siteDescription = 'Design lead with 10+ years bridging creative, engineering, and brand across large-scale ecommerce.';
---

<!doctype html>
<html lang="en" data-theme="light">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<!-- Fonts are self-hosted; Sanity CDN is the external origin -->
	<link rel="preconnect" href="https://cdn.sanity.io" />
	<!-- Preload critical body font (LCP-critical — hero text uses body font) -->
	<link rel="preload" as="font" href="/fonts/aeonik-pro/aeonik-pro-regular.woff2" type="font/woff2" crossorigin="anonymous" />
	<!-- Preload heading font -->
	<link rel="preload" as="font" href="/fonts/md-nichrome/MDNichromeTrial-Regular.woff2" type="font/woff2" crossorigin="anonymous" />
	<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
	<meta name="generator" content={Astro.generator} />
	<ClientRouter />
	<title>
		<slot name="title">{siteTitle}</slot>
	</title>
	<meta name="description" content={siteDescription} />
	<!-- Open Graph -->
	<meta property="og:title" content={siteTitle} />
	<meta property="og:description" content={siteDescription} />
	<meta property="og:type" content="website" />
	<meta property="og:url" content={Astro.url.href} />
	<!-- Twitter -->
	<meta name="twitter:card" content="summary_large_image" />
	<meta name="twitter:title" content={siteTitle} />
	<meta name="twitter:description" content={siteDescription} />
	<style is:global is:inline>
		/* ── Font Faces ── */

		@font-face {
			font-family: 'Aeonik Pro';
			src: url('/fonts/aeonik-pro/aeonik-pro-light.woff2') format('woff2');
			font-weight: 300;
			font-style: normal;
			font-display: swap;
		}

		@font-face {
			font-family: 'Aeonik Pro';
			src: url('/fonts/aeonik-pro/aeonik-pro-light-italic.woff2') format('woff2');
			font-weight: 300;
			font-style: italic;
			font-display: swap;
		}

		@font-face {
			font-family: 'Aeonik Pro';
			src: url('/fonts/aeonik-pro/aeonik-pro-regular.woff2') format('woff2');
			font-weight: 400;
			font-style: normal;
			font-display: swap;
		}

		@font-face {
			font-family: 'Aeonik Pro';
			src: url('/fonts/aeonik-pro/aeonik-pro-regular-italic.woff2') format('woff2');
			font-weight: 400;
			font-style: italic;
			font-display: swap;
		}

		@font-face {
			font-family: 'Aeonik Pro';
			src: url('/fonts/aeonik-pro/aeonik-pro-medium.woff2') format('woff2');
			font-weight: 500;
			font-style: normal;
			font-display: swap;
		}

		@font-face {
			font-family: 'Aeonik Pro';
			src: url('/fonts/aeonik-pro/aeonik-pro-medium-italic.woff2') format('woff2');
			font-weight: 500;
			font-style: italic;
			font-display: swap;
		}

		@font-face {
			font-family: 'Aeonik Pro';
			src: url('/fonts/aeonik-pro/aeonik-pro-bold.woff2') format('woff2');
			font-weight: 700;
			font-style: normal;
			font-display: swap;
		}

		@font-face {
			font-family: 'Aeonik Pro';
			src: url('/fonts/aeonik-pro/aeonik-pro-bold-italic.woff2') format('woff2');
			font-weight: 700;
			font-style: italic;
			font-display: swap;
		}

		@font-face {
			font-family: 'MD Nichrome';
			src: url('/fonts/md-nichrome/MDNichromeTrial-Regular.woff2') format('woff2');
			font-weight: 400;
			font-style: normal;
			font-display: swap;
		}

		@font-face {
			font-family: 'MD Nichrome';
			src: url('/fonts/md-nichrome/MDNichromeTrial-Bold.woff2') format('woff2');
			font-weight: 700;
			font-style: normal;
			font-display: swap;
		}

		/* ── Tokens ── */
		:root {
			/* Colors — Light (default) */
			--color-bg: #fafafa;
			--color-bg-secondary: #f0f0f0;
			--color-off-white: #f5f5f3;
			--color-fg: #1a1a1a;
			--color-fg-secondary: #6b6b6b;
			--color-accent: #000000;
			--color-border: #e5e5e5;
			--color-border-secondary: #d4d4d4;
			--color-focus: #000000;

			/* Font Families */
			--font-body: 'Aeonik Pro', Helvetica, Arial, sans-serif;
			--font-heading: 'MD Nichrome', Helvetica, Arial, sans-serif;
			--font-mono: ui-monospace, SFMono-Regular, monospace;

			/* Type Scale — Heading scale anchored to --sg-min-heading-size (H6) */
			--sg-min-heading-size: 1rem;
			--sg-font-scale: 1.3;
			--font-size-body: 0.875rem;
			--font-size-h6: var(--sg-min-heading-size);
			--font-size-h5: calc(var(--sg-min-heading-size) * var(--sg-font-scale));
			--font-size-h4: calc(var(--sg-min-heading-size) * var(--sg-font-scale) * var(--sg-font-scale));
			--font-size-h3: calc(var(--sg-min-heading-size) * var(--sg-font-scale) * var(--sg-font-scale) * var(--sg-font-scale));
			--font-size-h2: calc(var(--sg-min-heading-size) * var(--sg-font-scale) * var(--sg-font-scale) * var(--sg-font-scale) * var(--sg-font-scale));
			--font-size-h1: calc(var(--sg-min-heading-size) * var(--sg-font-scale) * var(--sg-font-scale) * var(--sg-font-scale) * var(--sg-font-scale) * var(--sg-font-scale));
			--font-size-xl: calc(var(--sg-min-heading-size) * var(--sg-font-scale) * var(--sg-font-scale) * var(--sg-font-scale) * var(--sg-font-scale) * var(--sg-font-scale) * var(--sg-font-scale));
			--font-size-caption: 0.75rem;
			--font-size-utility: 0.75rem;
			--font-size-meta: 0.6875rem;

			/* Weights */
			--font-weight-regular: 400;
			--font-weight-medium: 500;
			--font-weight-bold: 700;
			--font-weight-heading: 700;
			--font-weight-body: 400;
			--font-weight-utility: 500;

			/* Line Heights */
			--line-height-tight: 1.1;
			--line-height-heading: 1.2;
			--line-height-body: 1.5;

			/* Letter Spacing */
			--letter-spacing-heading: -0.01em;
			--letter-spacing-body: 0em;
			--letter-spacing-utility: 0.06em;
			--letter-spacing-meta: 0.04em;

			/* Spacing (3xs → 3xl) */
			--space-3xs: 0.25rem;
			--space-2xs: 0.5rem;
			--space-xs:  0.75rem;
			--space-sm:  1rem;
			--space-md:  1.5rem;
			--space-lg:  3rem;
			--space-xl:  4rem;
			--space-2xl: 6rem;
			--space-3xl: 8rem;

			/* Borders */
			--border-width-1: 1px;

			/* Border Radius */
			--radius-sm: 0.25rem;
			--radius-md: 0.5rem;
			--radius-lg: 0.75rem;
			--radius-full: 9999px;

			/* Shadows */
			--shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.04);
			--shadow-md: 0 4px 12px rgba(0, 0, 0, 0.06);
			--shadow-lg: 0 12px 24px rgba(0, 0, 0, 0.08);
			--shadow-elevated: 0 24px 48px rgba(0, 0, 0, 0.18);

			/* Transitions */
			--transition-fast: 150ms ease;
			--transition-base: 200ms ease;
			--transition-slow: 300ms cubic-bezier(0.4, 0, 0.2, 1);
			--transition-spring: 500ms cubic-bezier(0.34, 1.56, 0.64, 1);

			/* Focus Ring */
			--focus-ring-width: 2px;
			--focus-ring-offset: 2px;
			--focus-ring-color: var(--color-focus);

			/* Z-Index */
			--z-dropdown: 100;
			--z-sticky: 200;
			--z-overlay: 300;
			--z-modal: 400;

			/* Layout */
			--page-margin: var(--space-sm);
			--max-page-width: 75rem;
		}

		/* ── Dark Theme ── */
		[data-theme="dark"] {
			--color-bg: #0a0a0a;
			--color-bg-secondary: #141414;
			--color-fg: #e8e8e8;
			--color-fg-secondary: #8a8a8a;
			--color-accent: #ffffff;
			--color-border: #1e1e1e;
			--color-border-secondary: #2a2a2a;
			--color-focus: #ffffff;
			--shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.2);
			--shadow-md: 0 4px 12px rgba(0, 0, 0, 0.25);
			--shadow-lg: 0 12px 24px rgba(0, 0, 0, 0.3);
			--shadow-elevated: 0 24px 48px rgba(0, 0, 0, 0.6);
		}

		/* ── Reset ── */
		*, *::before, *::after {
			box-sizing: border-box;
			margin: 0;
			padding: 0;
		}

		::selection {
			background: color-mix(in srgb, var(--color-accent) 15%, transparent);
		}

		/* ── Base ── */
		html {
			font-size: 100%;
			-webkit-font-smoothing: antialiased;
			-moz-osx-font-smoothing: grayscale;
		}

		body {
			min-height: 100vh;
			display: flex;
			flex-direction: column;
			align-items: stretch;
			font-family: var(--font-body);
			font-size: var(--font-size-body);
			font-weight: var(--font-weight-body);
			line-height: var(--line-height-body);
			letter-spacing: var(--letter-spacing-body);
			color: var(--color-fg);
			background-color: var(--color-bg);
		}

		/* ── Typography ── */
		h1, h2, h3, h4, h5 {
			font-family: var(--font-heading);
			font-weight: var(--font-weight-heading);
			line-height: var(--line-height-heading);
			letter-spacing: var(--letter-spacing-heading);
		}

		h1 { font-size: var(--font-size-h1); }
		h2 { font-size: var(--font-size-h2); }
		h3 { font-size: var(--font-size-h3); }
		h4 { font-size: var(--font-size-h4); }
		h5 { font-size: var(--font-size-h5); }

		h6 {
			font-family: var(--font-body);
			font-weight: var(--font-weight-body);
			font-size: var(--font-size-h6);
			line-height: var(--line-height-heading);
		}

		/* Paragraphs — spacing handled by flex gap on parent containers */
		p {
		}

		caption, .caption {
			font-size: var(--font-size-caption);
			color: var(--color-fg-secondary);
		}

		.utility, .label, .meta {
			font-size: var(--font-size-utility);
			font-weight: var(--font-weight-utility);
			text-transform: uppercase;
			letter-spacing: var(--letter-spacing-utility);
		}

		.meta, .meta-text {
			font-size: var(--font-size-meta);
			letter-spacing: var(--letter-spacing-meta);
			color: var(--color-fg-secondary);
		}

		/* ── Links ── */
		a {
			color: inherit;
			text-decoration: none;
		}

		a:hover {
			text-decoration: underline;
			text-underline-offset: var(--space-3xs);
		}

		/* ── Focus ── */
		:focus-visible {
			outline: var(--focus-ring-width) solid var(--focus-ring-color);
			outline-offset: var(--focus-ring-offset);
		}

		/* ── Smooth Scroll ── */
		html {
			scroll-behavior: smooth;
		}

		/* ── Buttons ── */
		button {
			font-family: inherit;
			cursor: pointer;
		}

		.btn {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			gap: var(--space-2xs);
			padding: var(--space-2xs) var(--space-sm);
			font-size: var(--font-size-body);
			font-weight: var(--font-weight-medium);
			line-height: 1;
			border-radius: var(--radius-md);
			transition: background var(--transition-fast), color var(--transition-fast),
				border-color var(--transition-fast), box-shadow var(--transition-fast),
				transform var(--transition-fast);
			border: var(--border-width-1) solid transparent;
			outline: none;
		}

		.btn-primary {
			background: var(--color-accent);
			color: var(--color-bg);
			box-shadow: var(--shadow-sm);
		}

		.btn-primary:hover {
			box-shadow: var(--shadow-md);
		}

		.btn-primary:active {
			transform: scale(0.97);
		}

		.btn-secondary {
			background: transparent;
			border-color: var(--color-border);
			color: var(--color-fg);
		}

		.btn-secondary:hover {
			border-color: var(--color-accent);
		}

		.btn-secondary:active {
			transform: scale(0.97);
		}

		.btn-ghost {
			background: transparent;
			border-color: transparent;
			color: var(--color-fg);
		}

		.btn-ghost:hover {
			background: var(--color-bg-secondary);
		}

		.btn-ghost:active {
			transform: scale(0.97);
		}

		/* ── Inputs ── */
		input, textarea, select {
			font-family: inherit;
			font-size: var(--font-size-body);
			padding: var(--space-2xs) var(--space-xs);
			border: var(--border-width-1) solid var(--color-border);
			border-radius: var(--radius-md);
			background: var(--color-bg);
			color: var(--color-fg);
			transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
			outline: none;
		}

		input:focus, textarea:focus, select:focus {
			border-color: var(--color-accent);
			box-shadow: 0 0 0 var(--focus-ring-width) color-mix(in srgb, var(--color-accent) 15%, transparent);
		}

		textarea {
			min-height: 6rem;
			resize: vertical;
		}

		label {
			display: block;
			font-size: var(--font-size-utility);
			font-weight: var(--font-weight-medium);
			margin-bottom: var(--space-3xs);
			text-transform: uppercase;
			letter-spacing: var(--letter-spacing-utility);
		}

		/* ── Checkboxes & Radio ── */
		input[type="checkbox"],
		input[type="radio"] {
			accent-color: var(--color-accent);
		}

		/* ── Accordion ── */
		.accordion-trigger {
			width: 100%;
			display: flex;
			justify-content: space-between;
			align-items: center;
			padding: var(--space-xs) 0;
			background: none;
			border: none;
			border-bottom: var(--border-width-1) solid var(--color-border);
			color: var(--color-fg);
			font-size: var(--font-size-body);
			font-weight: var(--font-weight-medium);
			text-align: left;
			cursor: pointer;
			transition: color var(--transition-fast), border-color var(--transition-fast);
		}

		.accordion-trigger:hover {
			color: var(--color-accent);
		}

		.accordion-trigger[aria-expanded="true"] {
			border-bottom-color: var(--color-border-secondary);
		}

		.accordion-trigger .accordion-icon {
			font-weight: var(--font-weight-regular);
			transition: transform var(--transition-slow);
			user-select: none;
			flex-shrink: 0;
			margin-left: var(--space-2xs);
		}

		.accordion-trigger[aria-expanded="true"] .accordion-icon {
			transform: rotate(45deg);
		}

		.accordion-panel {
			border-bottom: var(--border-width-1) solid var(--color-border);
			overflow: hidden;
			transition: height 0.3s ease;
		}

		.accordion-panel p {
			padding: var(--space-xs) 0;
			color: var(--color-fg-secondary);
		}

		/* ── Badges ── */
		.badge {
			display: inline-block;
			padding: var(--space-3xs) var(--space-2xs);
			font-size: var(--font-size-meta);
			font-weight: var(--font-weight-medium);
			text-transform: uppercase;
			letter-spacing: var(--letter-spacing-meta);
			border-radius: var(--radius-full);
			border: var(--border-width-1) solid var(--color-border);
			background: var(--color-bg-secondary);
			color: var(--color-fg-secondary);
			line-height: 1;
		}

		.badge-accent {
			background: var(--color-accent);
			color: var(--color-bg);
			border-color: var(--color-accent);
		}

		/* ── Cards ── */
		.card {
			background: var(--color-bg);
			border: var(--border-width-1) solid var(--color-border);
			border-radius: var(--radius-lg);
			padding: var(--space-sm);
			box-shadow: var(--shadow-sm);
			transition: box-shadow var(--transition-base), transform var(--transition-slow),
				border-color var(--transition-fast);
		}

		.card:hover {
			box-shadow: var(--shadow-md);
			transform: translateY(-2px);
			border-color: var(--color-border-secondary);
		}

		/* ── Divider ── */
		hr, .divider {
			border: none;
			border-top: var(--border-width-1) solid var(--color-border);
			margin: var(--space-md) 0;
		}

		/* ── Layout ── */
		.container {
			width: 100%;
			max-width: var(--max-page-width);
			margin-left: auto;
			margin-right: auto;
			padding-left: var(--page-margin);
			padding-right: var(--page-margin);
		}

		/* Header/footer stretch to full width; main centers via flex */
		header,
		footer {
			width: 100%;
		}

		main {
			flex: 1 0 auto;
			max-width: var(--max-page-width);
			padding-left: var(--page-margin);
			padding-right: var(--page-margin);
		}

		footer {
			padding-top: var(--space-lg);
			padding-bottom: var(--space-lg);
			margin-top: var(--space-xl);
		}

		footer .container {
			max-width: none;
		}

		footer nav {
			display: flex;
			gap: var(--space-md);
		}

		footer nav a {
			text-decoration: none;
			color: var(--color-fg-secondary);
			font-size: var(--font-size-body);
			transition: color var(--transition-fast);
			position: relative;
		}

		footer nav a:hover {
			color: var(--color-fg);
		}

		footer .copyright {
			margin-top: var(--space-md);
			color: var(--color-fg-secondary);
			font-size: var(--font-size-body);
		}

		/* ── Tweak System ── */
		.tweak-toggle {
			position: fixed;
			bottom: var(--space-sm);
			right: var(--space-sm);
			z-index: var(--z-modal);
			width: var(--space-lg);
			height: var(--space-lg);
			display: grid;
			place-items: center;
			background: var(--color-accent);
			color: var(--color-bg);
			border: none;
			border-radius: var(--radius-full);
			cursor: pointer;
			transition: opacity var(--transition-fast), transform var(--transition-spring);
			box-shadow: var(--shadow-elevated);
		}

		.tweak-toggle:hover {
			opacity: 0.85;
			transform: scale(1.05);
		}

		.tweak-toggle:active {
			transform: scale(0.95);
		}

		.tweak-toggle svg {
			width: var(--space-md);
			height: var(--space-md);
			transition: transform var(--transition-slow);
		}

		.tweak-toggle[aria-expanded="true"] svg {
			transform: rotate(90deg);
		}

		/* Menu */
		.tweak-menu {
			position: fixed;
			bottom: calc(var(--space-sm) + var(--space-lg) + var(--space-2xs));
			right: var(--space-sm);
			z-index: var(--z-modal);
			background: var(--color-bg-secondary);
			border: var(--border-width-1) solid var(--color-border);
			border-radius: var(--radius-md);
			padding: var(--space-3xs);
			opacity: 0;
			transform: translateY(var(--space-2xs)) scale(0.96);
			pointer-events: none;
			transition: opacity var(--transition-slow), transform var(--transition-spring);
			box-shadow: var(--shadow-elevated);
		}

		.tweak-menu.visible {
			opacity: 1;
			transform: translateY(0) scale(1);
			pointer-events: auto;
		}

		.tweak-menu-item {
			display: block;
			width: 100%;
			padding: var(--space-2xs) var(--space-xs);
			font-size: var(--font-size-body);
			font-weight: var(--font-weight-medium);
			text-align: left;
			background: none;
			border: none;
			color: var(--color-fg);
			cursor: pointer;
			border-radius: var(--radius-sm);
			transition: background var(--transition-fast), color var(--transition-fast);
		}

		.tweak-menu-item:hover {
			background: var(--color-border);
		}

		.tweak-menu-item:active {
			background: var(--color-border-secondary);
		}

		/* Drawer */
		.tweak-overlay {
			position: fixed;
			inset: 0;
			z-index: var(--z-modal);
			display: flex;
			justify-content: flex-end;
			pointer-events: none;
			background: transparent;
			transition: background var(--transition-base);
		}

		.tweak-overlay.active {
			pointer-events: auto;
			background: rgba(0, 0, 0, 0.15);
		}

		.tweak-drawer {
			width: min(320px, 90vw);
			height: 100%;
			background: var(--color-bg-secondary);
			border-left: var(--border-width-1) solid var(--color-border);
			padding: var(--space-sm);
			overflow-y: auto;
			transform: translateX(100%);
			transition: transform var(--transition-spring);
			box-shadow: var(--shadow-elevated);
			will-change: transform;
		}

		.tweak-overlay.active .tweak-drawer {
			transform: translateX(0);
		}

		.tweak-drawer-header {
			display: flex;
			justify-content: space-between;
			align-items: center;
			margin-bottom: var(--space-sm);
		}

		.tweak-title {
			font-family: var(--font-heading);
			font-size: var(--font-size-h5);
			font-weight: var(--font-weight-heading);
			text-transform: uppercase;
			letter-spacing: var(--letter-spacing-heading);
		}

		.tweak-close {
			background: none;
			border: none;
			color: var(--color-fg-secondary);
			cursor: pointer;
			padding: var(--space-3xs);
			display: grid;
			place-items: center;
			transition: color var(--transition-fast);
		}

		.tweak-close:hover {
			color: var(--color-fg);
		}

		.tweak-close svg {
			width: var(--space-md);
			height: var(--space-md);
		}

		.tweak-theme-toggle {
			display: flex;
			gap: var(--space-3xs);
			margin-bottom: var(--space-sm);
		}

		.tweak-theme-btn {
			flex: 1;
			padding: var(--space-2xs) var(--space-xs);
			font-size: var(--font-size-utility);
			font-weight: var(--font-weight-medium);
			text-transform: uppercase;
			letter-spacing: var(--letter-spacing-utility);
			border: var(--border-width-1) solid var(--color-border);
			border-radius: var(--radius-md);
			background: transparent;
			color: var(--color-fg-secondary);
			cursor: pointer;
			transition: all var(--transition-fast);
		}

		.tweak-theme-btn:hover {
			border-color: var(--color-border-secondary);
			color: var(--color-fg);
		}

		.tweak-theme-btn.active {
			background: var(--color-accent);
			color: var(--color-bg);
			border-color: var(--color-accent);
		}

		.tweak-theme-btn:active {
			transform: scale(0.97);
		}

		.tweak-section h3 {
			margin-bottom: var(--space-xs);
		}

		.tweak-section-title {
			font-size: var(--font-size-utility);
			font-weight: var(--font-weight-medium);
			text-transform: uppercase;
			letter-spacing: var(--letter-spacing-utility);
			color: var(--color-fg-secondary);
			margin-bottom: var(--space-xs);
		}

		.tweak-control {
			display: flex;
			align-items: center;
			gap: var(--space-2xs);
			margin-bottom: var(--space-2xs);
		}

		.tweak-control label {
			flex: 1;
			font-size: var(--font-size-body);
			text-transform: none;
			letter-spacing: inherit;
			margin-bottom: 0;
		}

		.tweak-control input[type="color"] {
			width: var(--space-md);
			height: var(--space-md);
			padding: 0;
			border: none;
			border-radius: var(--radius-sm);
			cursor: pointer;
		}

		.tweak-hex {
			font-family: var(--font-mono);
			font-size: var(--font-size-meta);
			color: var(--color-fg-secondary);
			min-width: var(--space-lg);
			text-align: right;
		}

		/* Typography tweak controls */
		.tweak-slider-control {
			display: flex;
			flex-direction: column;
			gap: var(--space-3xs);
			margin-bottom: var(--space-xs);
		}

		.tweak-slider-header {
			display: flex;
			justify-content: space-between;
			align-items: baseline;
		}

		.tweak-slider-header label {
			font-size: var(--font-size-body);
			text-transform: none;
			letter-spacing: inherit;
			margin-bottom: 0;
		}

		.tweak-slider-value {
			font-family: var(--font-mono);
			font-size: var(--font-size-meta);
			color: var(--color-fg-secondary);
		}

		.tweak-slider-control input[type="range"] {
			width: 100%;
			height: var(--space-2xs);
			cursor: pointer;
			accent-color: var(--color-accent);
		}
	</style>
</head>

<body>
	<Header navLinks={header?.links} transition:persist />
	<ContactDrawer />

	<main transition:animate="fade">
		<slot />
	</main>

	<footer>
		<div class="container">
			<nav>
				{footer?.links?.map((link) => (
					<a href={link.href} {...(link.openInNewTab ? {target: '_blank', rel: 'noopener'} : {})}>
						{link.label}
					</a>
				))}
			</nav>
			{footer?.copyright && (
				<p class="copyright">{footer.copyright}</p>
			)}
		</div>
	</footer>

	<!-- Tweak System: Gear button → menu → drawer panels -->
	<button id="tweakToggleBtn" class="tweak-toggle" aria-label="Open tweak menu">
		<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<circle cx="12" cy="12" r="3"/>
			<path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>
		</svg>
	</button>

	<div id="tweakMenu" class="tweak-menu">
		<button class="tweak-menu-item" data-panel="color">Color</button>
		<button class="tweak-menu-item" data-panel="typography">Typography</button>
	</div>

	<div id="tweakOverlay" class="tweak-overlay">
		<div id="tweakDrawer" class="tweak-drawer">
			<div class="tweak-drawer-header">
				<h2 id="tweakDrawerTitle" class="tweak-title"></h2>
				<button id="tweakClose" class="tweak-close" aria-label="Close">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<line x1="18" y1="6" x2="6" y2="18"/>
						<line x1="6" y1="6" x2="18" y2="18"/>
					</svg>
				</button>
			</div>
			<div id="tweakDrawerContent" class="tweak-content"></div>
		</div>
	</div>

	<script is:inline>
		// ── Tweak System ──
		(function () {
			const toggleBtn = document.getElementById('tweakToggleBtn');
			const menu = document.getElementById('tweakMenu');
			const overlay = document.getElementById('tweakOverlay');
			const closeBtn = document.getElementById('tweakClose');
			const titleEl = document.getElementById('tweakDrawerTitle');
			const contentEl = document.getElementById('tweakDrawerContent');
			const docHtml = document.documentElement;

			let menuOpen = false;
			let drawerOpen = false;
			let activeTheme = docHtml.getAttribute('data-theme') || 'light';

			// SVG icons
			const gearSVG = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>`;
			const closeSVG = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>`;

			// ── Color Panel Data ──
			const colorData = {
				themes: {
					light: {
						'--color-bg': '#fafafa',
						'--color-bg-secondary': '#f0f0f0',
						'--color-fg': '#1a1a1a',
						'--color-fg-secondary': '#6b6b6b',
						'--color-accent': '#000000',
						'--color-border': '#e5e5e5',
						'--color-border-secondary': '#d4d4d4',
					},
					dark: {
						'--color-bg': '#0a0a0a',
						'--color-bg-secondary': '#141414',
						'--color-fg': '#e8e8e8',
						'--color-fg-secondary': '#8a8a8a',
						'--color-accent': '#ffffff',
						'--color-border': '#1e1e1e',
						'--color-border-secondary': '#2a2a2a',
					}
				},
				tokenLabels: {
					'--color-bg': 'Background',
					'--color-bg-secondary': 'Background 2',
					'--color-fg': 'Foreground',
					'--color-fg-secondary': 'Foreground 2',
					'--color-accent': 'Accent',
					'--color-border': 'Border',
					'--color-border-secondary': 'Border 2',
				}
			};

			// ── Typography Panel Data ──
			const typoData = {
				minHeadingSize: { token: '--sg-min-heading-size', label: 'Min Heading Size (H6)', min: 0.875, max: 2.5, step: 0.0625, unit: 'rem' },
				scaleRatio: { token: '--sg-font-scale', label: 'Scale Ratio', min: 1.1, max: 1.6, step: 0.05, unit: '' },
				bodySize: { token: '--font-size-body', label: 'Body Size', min: 0.75, max: 1.25, step: 0.0625, unit: 'rem' },
				lineHeightBody: { token: '--line-height-body', label: 'Body Line Height', min: 1.2, max: 2.0, step: 0.05, unit: '' },
				lineHeightHeading: { token: '--line-height-heading', label: 'Heading Line Height', min: 1.0, max: 1.6, step: 0.05, unit: '' },
				letterSpacingHeading: { token: '--letter-spacing-heading', label: 'Heading Letter Spacing', min: -0.04, max: 0.04, step: 0.005, unit: 'em' },
			};

			// ── Menu Toggle ──
			function toggleMenu() {
				menuOpen = !menuOpen;
				menu.classList.toggle('visible', menuOpen);
				if (menuOpen) {
					toggleBtn.innerHTML = closeSVG;
				} else {
					toggleBtn.innerHTML = gearSVG;
				}
			}

			// ── Drawer ──
			function openDrawer(panel) {
				drawerOpen = true;
				menuOpen = false;
				menu.classList.remove('visible');
				toggleBtn.innerHTML = closeSVG;

				if (panel === 'color') {
					titleEl.textContent = 'Color';
					renderColorPanel();
				} else if (panel === 'typography') {
					titleEl.textContent = 'Typography';
					renderTypoPanel();
				}

				overlay.classList.add('active');
			}

			function closeDrawer() {
				drawerOpen = false;
				overlay.classList.remove('active');
				toggleBtn.innerHTML = gearSVG;
			}

			// ── Color Panel ──
			function renderColorPanel() {
				const theme = colorData.themes[activeTheme];
				let markup = '<div class="tweak-theme-toggle">';
				for (const [name] of Object.entries(colorData.themes)) {
					const active = name === activeTheme ? 'active' : '';
					markup += `<button class="tweak-theme-btn ${active}" data-theme="${name}">${name}</button>`;
				}
				markup += '</div>';
				markup += '<div class="tweak-section"><div class="tweak-section-title">Tokens</div>';
				for (const [token, label] of Object.entries(colorData.tokenLabels)) {
					const hex = theme[token] || '#000000';
					markup += `<div class="tweak-control"><label>${label}</label><input type="color" value="${hex}" data-token="${token}" data-theme="${activeTheme}" /><span class="tweak-hex">${hex}</span></div>`;
				}
				markup += '</div>';
				contentEl.innerHTML = markup;

				contentEl.querySelectorAll('.tweak-theme-btn').forEach(btn => {
					btn.addEventListener('click', () => {
						activeTheme = btn.dataset.theme;
						docHtml.setAttribute('data-theme', activeTheme);
						renderColorPanel();
					});
				});

				contentEl.querySelectorAll('input[type="color"]').forEach(input => {
					input.addEventListener('input', (e) => {
						const token = e.target.dataset.token;
						const theme = e.target.dataset.theme;
						const value = e.target.value;
						colorData.themes[theme][token] = value;
						docHtml.style.setProperty(token, value);
						const hexSpan = e.target.parentElement.querySelector('.tweak-hex');
						if (hexSpan) hexSpan.textContent = value;
					});
				});
			}

			// ── Typography Panel ──
			function renderTypoPanel() {
				let markup = '<div class="tweak-section"><div class="tweak-section-title">Type Scale</div>';
				for (const [key, config] of Object.entries(typoData)) {
					const currentVal = parseFloat(getComputedStyle(docHtml).getPropertyValue(config.token));
					markup += `<div class="tweak-slider-control">
						<div class="tweak-slider-header">
							<label>${config.label}</label>
							<span class="tweak-slider-value" data-val="${key}">${currentVal.toFixed(3)}</span>
						</div>
						<input type="range" min="${config.min}" max="${config.max}" step="${config.step}" value="${currentVal}" data-token="${config.token}" data-key="${key}" />
					</div>`;
				}
				markup += '</div>';
				contentEl.innerHTML = markup;

				contentEl.querySelectorAll('input[type="range"]').forEach(input => {
					input.addEventListener('input', (e) => {
						const token = e.target.dataset.token;
						const key = e.target.dataset.key;
						const value = parseFloat(e.target.value);
						const config = typoData[key];
						docHtml.style.setProperty(token, value + config.unit);
						const valSpan = contentEl.querySelector(`[data-val="${key}"]`);
						if (valSpan) valSpan.textContent = value.toFixed(3);
					});
				});
			}

			// ── Event Listeners ──
			toggleBtn.addEventListener('click', () => {
				if (drawerOpen) {
					closeDrawer();
				} else {
					toggleMenu();
				}
			});

			menu.querySelectorAll('.tweak-menu-item').forEach(item => {
				item.addEventListener('click', () => {
					const panel = item.dataset.panel;
					openDrawer(panel);
				});
			});

			closeBtn.addEventListener('click', closeDrawer);

			overlay.addEventListener('click', (e) => {
				if (e.target === overlay) closeDrawer();
			});

			document.addEventListener('keydown', (e) => {
				if (e.key === 'Escape') {
					if (drawerOpen) closeDrawer();
					else if (menuOpen) toggleMenu();
				}
			});

			// Click outside closes menu
			document.addEventListener('click', (e) => {
				if (menuOpen && !menu.contains(e.target) && e.target !== toggleBtn && !toggleBtn.contains(e.target)) {
					menuOpen = false;
					menu.classList.remove('visible');
					toggleBtn.innerHTML = gearSVG;
				}
			});

			// Auto-open from URL params
			const params = new URLSearchParams(window.location.search);
			const tweakParam = params.get('tweak');
			if (tweakParam) {
				openDrawer(tweakParam);
			}
		})();

		// Enable bfcache (back/forward cache) — empty handler signals browser compatibility
		window.addEventListener('pagehide', () => {});

		// ── Accordion ──
		(function () {
			document.querySelectorAll('.accordion-trigger').forEach(trigger => {
				trigger.addEventListener('click', () => {
					const expanded = trigger.getAttribute('aria-expanded') === 'true';
					trigger.setAttribute('aria-expanded', String(!expanded));
					const panel = trigger.nextElementSibling;
					if (panel && panel.classList.contains('accordion-panel')) {
						if (expanded) {
							// Close: animate from current height to 0
							panel.style.height = panel.scrollHeight + 'px';
							panel.style.overflow = 'hidden';
							requestAnimationFrame(() => {
								panel.style.height = '0';
							});
						} else {
							// Open: animate from 0 to measured height
							panel.style.overflow = 'hidden';
							panel.style.height = '0';
							const h = panel.scrollHeight;
							requestAnimationFrame(() => {
								panel.style.height = h + 'px';
							});
							// Clean up to auto after transition ends
							setTimeout(() => {
								panel.style.height = 'auto';
								panel.style.overflow = '';
							}, 400);
						}
					}
				});
			});
			// Initialize collapsed panels
			document.querySelectorAll('.accordion-trigger').forEach(trigger => {
				if (trigger.getAttribute('aria-expanded') !== 'true') {
					const panel = trigger.nextElementSibling;
					if (panel && panel.classList.contains('accordion-panel')) {
						panel.style.height = '0';
						panel.style.overflow = 'hidden';
					}
				}
			});
		})();
	</script>
	{enableVisualEditing && (
		<VisualEditing client:only="react" />
	)}
</body>
</html>
