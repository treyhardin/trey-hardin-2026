---
import SanityImage from './SanityImage.astro';

export interface HeroSectionProps {
	heading: string;
	subheading?: string;
	images: Array<{
		image: {
			asset: {
				_url: string;
				metadata: {
					dimensions: { width: number; height: number };
				};
			};
		};
		alt: string;
	}>;
}

export interface HeroSectionData {
	heading?: string;
	images?: HeroSectionProps['images'];
}

const { heading, subheading, images } = Astro.props;
---

{heading && images && images.length > 0 && (
<section class="hero-section">
	<h2 class="hero-section__heading">{heading}</h2>

	<div class="hero-section__bottom">
		{subheading && <p class="hero-section__subheading">{subheading}</p>}
		<div class="hero-section__gallery-wrap">
			<div class="hero-section__gallery" id="hero-gallery">
				{images.map((img, i) => (
					<div class={`hero-section__image ${i === 0 ? 'hero-section__image--active' : ''}`}>
						<SanityImage
							image={img}
							loading="eager"
							aspectRatio="auto"
						/>
					</div>
				))}
			</div>
		</div>
	</div>
</section>
)}

<script>
	const gallery = document.getElementById('hero-gallery');
	if (gallery) {
		const slides = gallery.querySelectorAll('.hero-section__image');
		if (slides.length > 1) {
			// Preload and decode all images before cycling to avoid flash
			const allImages = gallery.querySelectorAll('img');
			const decodePromises = Array.from(allImages).map(img => {
				return img.decode ? img.decode().catch(() => {}) : Promise.resolve();
			});

			Promise.allSettled(decodePromises).then(() => {
				let current = 0;
				setInterval(() => {
					slides[current].classList.remove('hero-section__image--active');
					current = (current + 1) % slides.length;
					slides[current].classList.add('hero-section__image--active');
				}, 400);
			});
		}
	}
</script>

<style is:inline>
	.hero-section {
		height: calc(100dvh - var(--header-height));
		padding: var(--page-margin) 0;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		align-items: flex-start;
		gap: var(--space-xl);
		overflow: hidden;
}

	.hero-section__heading {
		font-family: var(--font-heading);
		font-size: calc(var(--font-size-xl) * var(--sg-font-scale));
		font-weight: var(--font-weight-bold);
		line-height: var(--line-height-heading);
		letter-spacing: var(--letter-spacing-heading);
		max-width: 50ch;
	}

	.hero-section__bottom {
		display: flex;
		flex: 1 1 auto;
		min-height: 0;
		width: 100%;
		justify-content: space-between;
		align-items: stretch;
		gap: var(--space-xl);
		container-type: size;
	}

	.hero-section__subheading {
		flex: 0 0 30rem;
		min-width: 0;
		align-self: flex-start;
		/* Top-align with the gallery square, not just the row. When the square is width-capped it's
		   shorter than the row and sits bottom-pinned, so push the subheading down by exactly
		   (rowH - S). Same min() expression as the gallery width, in the same size container, so
		   they stay locked together; when height-capped this resolves to 0. */
		margin-top: calc(100cqh - min(calc(100cqi - 30rem - var(--space-xl)), 100cqh));
	}

	/* The gallery is always a true square, sized to the largest one that fits both axes.
	   Row mode: fills all space left of the subheading (width-driven), capped by row height. */
	.hero-section__gallery-wrap {
		flex: none;
		min-width: 0;
		align-self: stretch;   /* fills the full height of the stretched bottom row */
		display: flex;
		align-items: flex-end; /* pin the square to the row's bottom edge (viewport bottom) */
	}

	.hero-section__gallery {
		position: relative;
		width: min(calc(100cqi - 30rem - var(--space-xl)), 100cqh);
		aspect-ratio: 1 / 1;
		min-width: 0;
		overflow: hidden;
		border-radius: var(--radius-md);
		background: var(--color-bg-secondary);
	}

	/* Once the row gets tight, stack below the subheading. Everything stays inside main's
	   page-margin — the section no longer escapes to the viewport edges. The height becomes a
	   floor rather than a cap: if heading + subheading + square exceed the fold, the hero grows
	   and scrolls instead of squashing the square. */
	@media (max-width: 757px) {
		.hero-section {
			height: auto;
			min-height: calc(100dvh - var(--header-height));
		}
		.hero-section__bottom {
			flex-direction: column;
			/* Row mode uses container queries for the "largest square that fits" sizing, but a
			   size container reports no content height to its parent — with the section now
			   auto-height it would collapse back to the min-height and clip the square. The
			   stacked square is width-driven instead, so containment isn't needed here. */
			container-type: normal;
		}
		.hero-section__subheading { flex: none; width: auto; max-width: 30rem; margin-top: 0; } /* no size container in stacked mode */
		/* Square panel stays inside the page margin and remains a true 1:1 square at any width —
		   sized from its (content-box) width, so no flex growth or shrinking. */
		.hero-section__gallery-wrap {
			flex: none;
			width: 100%;
		}
		.hero-section__gallery {
			width: 100%;
			height: auto;
			aspect-ratio: 1 / 1; /* square regardless of width */
		}
	}

	.hero-section__image {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		display: none;
	}

	.hero-section__image--active {
		display: block;
	}

	.hero-section__image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
</style>
