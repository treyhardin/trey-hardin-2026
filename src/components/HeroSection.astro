---
import SanityImage from './SanityImage.astro';

export interface HeroSectionProps {
	heading: string;
	images: Array<{
		image: {
			asset: {
				_url: string;
				metadata: {
					dimensions: { width: number; height: number };
				};
			};
		};
		alt: string;
	}>;
}

export interface HeroSectionData {
	heading?: string;
	images?: HeroSectionProps['images'];
}

const { heading, images } = Astro.props;
---

{heading && images && images.length > 0 && (
<section class="hero-section">
	<h2 class="hero-section__heading">{heading}</h2>

	<div class="hero-section__gallery" id="hero-gallery">
		{images.map((img, i) => (
			<div class={`hero-section__image ${i === 0 ? 'hero-section__image--active' : ''}`}>
				<SanityImage
					image={img}
					loading={i === 0 ? 'eager' : 'lazy'}
					aspectRatio="auto"
				/>
			</div>
		))}
	</div>
</section>
)}

<script>
	const gallery = document.getElementById('hero-gallery');
	if (gallery) {
		const slides = gallery.querySelectorAll('.hero-section__image');
		if (slides.length > 1) {
			let current = 0;
			setInterval(() => {
				slides[current].classList.remove('hero-section__image--active');
				current = (current + 1) % slides.length;
				slides[current].classList.add('hero-section__image--active');
			}, 400);
		}
	}
</script>

<style is:inline>
	.hero-section {
		min-height: 90svh;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		align-items: flex-start;
	}

	.hero-section__heading {
		font-family: var(--font-heading);
		font-size: calc(var(--font-size-xl) * var(--sg-font-scale));
		font-weight: var(--font-weight-bold);
		line-height: 1.05;
		max-width: 50ch;
	}

	.hero-section__gallery {
		position: relative;
		width: 20vw;
		min-width: 150px;
		max-width: 280px;
		aspect-ratio: 1 / 1;
		overflow: hidden;
		border-radius: var(--radius-md);
		background: #e8e8e5;
		flex-shrink: 0;
		align-self: flex-end;
		margin-bottom: var(--space-4);
	}

	.hero-section__image {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		display: none;
	}

	.hero-section__image--active {
		display: block;
	}

	.hero-section__image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
</style>
