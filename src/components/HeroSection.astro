---
import SanityImage from './SanityImage.astro';

export interface HeroSectionProps {
	heading: string;
	subheading?: string;
	images: Array<{
		image: {
			asset: {
				_url: string;
				metadata: {
					dimensions: { width: number; height: number };
				};
			};
		};
		alt: string;
	}>;
}

export interface HeroSectionData {
	heading?: string;
	images?: HeroSectionProps['images'];
}

const { heading, subheading, images } = Astro.props;
---

{heading && images && images.length > 0 && (
<section class="hero-section">
	<h2 class="hero-section__heading">{heading}</h2>

	<div class="hero-section__bottom">
		{subheading && <p class="hero-section__subheading">{subheading}</p>}
		<div class="hero-section__gallery" id="hero-gallery">
			{images.map((img, i) => (
				<div class={`hero-section__image ${i === 0 ? 'hero-section__image--active' : ''}`}>
					<SanityImage
						image={img}
						loading="eager"
						aspectRatio="auto"
					/>
				</div>
			))}
		</div>
	</div>
</section>
)}

<script>
	const gallery = document.getElementById('hero-gallery');
	if (gallery) {
		const slides = gallery.querySelectorAll('.hero-section__image');
		if (slides.length > 1) {
			// Preload and decode all images before cycling to avoid flash
			const allImages = gallery.querySelectorAll('img');
			const decodePromises = Array.from(allImages).map(img => {
				return img.decode ? img.decode().catch(() => {}) : Promise.resolve();
			});

			Promise.allSettled(decodePromises).then(() => {
				let current = 0;
				setInterval(() => {
					slides[current].classList.remove('hero-section__image--active');
					current = (current + 1) % slides.length;
					slides[current].classList.add('hero-section__image--active');
				}, 400);
			});
		}
	}
</script>

<style is:inline>
	.hero-section {
		height: calc(100dvh - var(--header-height));
		padding: var(--page-margin) 0;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		align-items: flex-start;
		gap: var(--space-xl);
		overflow: hidden;
}

	.hero-section__heading {
		font-family: var(--font-heading);
		font-size: calc(var(--font-size-xl) * var(--sg-font-scale));
		font-weight: var(--font-weight-bold);
		line-height: var(--line-height-heading);
		letter-spacing: var(--letter-spacing-heading);
		max-width: 50ch;
	}

	.hero-section__bottom {
		display: flex;
		flex: 1 1 auto;
		min-height: 0;
		width: 100%;
		justify-content: space-between;
		align-items: stretch;
		gap: var(--space-xl);
	}

	.hero-section__subheading {
		flex: 0 0 30rem;
		align-self: flex-start;
	}

	.hero-section__gallery {
		position: relative;
		flex: 1 1 0;
		min-width: 25%;
		height: 100%;
		overflow: hidden;
		border-radius: var(--radius-md);
		background: var(--color-bg-secondary);
	}

	/* Once the gallery reaches its 25% floor, stack it below the subheading */
	@media (max-width: 757px) {
		.hero-section__bottom { flex-direction: column; }
		.hero-section__subheading { flex: none; width: auto; max-width: 30rem; }
		.hero-section__gallery { flex: 1 1 auto; min-height: 0; min-width: 0; height: auto; align-self: stretch; }
	}

	.hero-section__image {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		display: none;
	}

	.hero-section__image--active {
		display: block;
	}

	.hero-section__image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
</style>
