---
// Header: sticky top bar with name and nav links
// Accepts optional `navLinks` prop from Sanity; falls back to hardcoded defaults.
const currentPath = Astro.url.pathname;

interface NavLink {
	label: string;
	href: string;
	openInNewTab?: boolean;
}

const defaultNavLinks: NavLink[] = [
	{ label: 'Work', href: '/work' },
	{ label: 'About', href: '/about' },
	{ label: 'Writing', href: '/blog' },
	{ label: 'Experiments', href: '/experiments' },
	{ label: 'Clients', href: '/clients' },
];

const navLinks: NavLink[] = Astro.props.navLinks ?? defaultNavLinks;
---

<header class="site-header">
	<a href="/" class="site-logo h6">
		<span class="logo-trey">Trey</span>
		<span class="logo-expanded-clip">
			<span class="logo-expanded">&nbsp;Hardin</span>
		</span>
		<span class="logo-dot">.</span>
	</a>

	<nav class="site-nav">
		{navLinks.map(link => {
			const isActive = currentPath.startsWith(link.href);
			return (
				<a href={link.href} class:list={['nav-link', { active: isActive }]}>
					{link.label}
				</a>
			);
		})}
	</nav>
</header>

<style>
	.site-header {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: var(--z-sticky);
		height: var(--header-height);
		display: grid;
		grid-template-columns: 1fr 1fr;
		align-items: center;
		padding: var(--space-sm) var(--page-margin);
	}

	.site-logo {
		color: var(--color-fg);
		text-decoration: none;
		display: inline-flex;
		align-items: baseline;
		justify-self: start;
	}

	.site-logo:hover {
		text-decoration: none;
	}

	/* ── Logo hover animation ── */
	.logo-expanded-clip {
		display: inline-block;
		max-width: 0;
		overflow: hidden;
		vertical-align: baseline;
		transition: max-width var(--transition-slower);
	}

	.site-logo:hover .logo-expanded-clip {
		max-width: 6rem;
		transition-delay: 120ms;
	}

	.logo-expanded {
		white-space: nowrap;
	}

	.logo-dot {
		display: inline;
	}

	.site-nav {
		display: flex;
		gap: var(--space-lg);
		justify-self: start;
	}

	.nav-link {
		color: var(--color-fg-secondary);
		text-decoration: none;
		transition: color var(--transition-fast);
		position: relative;
	}

	.nav-link:hover {
		color: var(--color-fg);
		text-decoration: none;
	}

	.nav-link.active {
		color: var(--color-fg);
	}

	.nav-link.active::after {
		content: '';
		position: absolute;
		bottom: -4px;
		left: 0;
		right: 0;
		height: 1px;
		background: var(--color-accent);
	}
</style>

