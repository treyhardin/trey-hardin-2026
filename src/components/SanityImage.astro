---
import { urlFor } from '../lib/image';

/** A sanityImage object from Sanity: { image: <image ref>, alt: <string> } */
export interface SanityImageObject {
	/** The actual Sanity image asset reference. Includes hotspot/crop when focal point is set. */
	image: {
		_ref?: string;
		asset?: {
			_ref: string;
			assetDocumentId?: string;
		};
		/** Sanity crop offsets (0-1 range for each edge) */
		crop?: { top?: number; bottom?: number; left?: number; right?: number };
		/** Sanity hotspot — the focal point center + size (0-1 range) */
		hotspot?: { x?: number; y?: number; height?: number; width?: number };
		/** Asset metadata for intrinsic dimensions (CLS prevention) */
		metadata?: {
			dimensions?: { width?: number; height?: number; aspectRatio?: number };
		};
	};
	/** Alt text — filled in by the editor in Sanity Studio. */
	alt?: string;
}

export interface SanityImageProps {
	/** The sanityImage object from Sanity (contains `image` ref + `alt` text). */
	image: SanityImageObject;

	/** Responsive breakpoints in pixels. Defaults to [400, 600, 800, 1000, 1200, 1400]. */
	breakpoints?: number[];

	/** CSS aspect-ratio (e.g. "16/9", "1/1", "auto"). Defaults to "auto". */
	aspectRatio?: string;

	/** CSS object-fit value. Defaults to "cover". */
	objectFit?: 'cover' | 'contain' | 'fill';

	/** Explicit width override (px or CSS value). */
	width?: number | string;

	/** Explicit height override (px or CSS value). */
	height?: number | string;

	/** Loading strategy. Defaults to "lazy". Use "eager" for above-the-fold images. */
	loading?: 'lazy' | 'eager';

	/** Fetch priority hint. Use "high" for the LCP resource. */
	fetchpriority?: 'high' | 'low';

	/** Responsive `sizes` attribute. Defaults to "(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw". */
	sizes?: string;

	/** Enable blur-up placeholder using Sanity's tiny thumbnail. Defaults to true. */
	blurUp?: boolean;

	/** CSS class for the wrapper element. */
	className?: string;

	/** Additional props forwarded to the <img> element. */
	imgProps?: Record<string, string>;
}

const {
	image,
	breakpoints = [400, 600, 800, 1000, 1200, 1400],
	aspectRatio = 'auto',
	objectFit = 'cover',
	width,
	height,
	loading = 'lazy',
	fetchpriority,
	sizes,
	blurUp = true,
	className = '',
	imgProps = {},
} = Astro.props;

// The nested image asset reference (from sanityImage.image field)
const imageRef = image.image;

// Early return if no image — happens when the sanityImage object exists but has no asset
if (!imageRef) {
	return null;
}

// Get the asset reference ID — support direct _ref, resolved asset._id, or nested asset._ref
const assetId = imageRef._ref ?? imageRef._id ?? imageRef.asset?._ref;
if (!assetId) {
	throw new Error(`SanityImage: image asset reference not found. Received: ${JSON.stringify(image)}`);
}

// Pass full image object (with hotspot/crop) to urlFor so Sanity CDN crops around focal point
const baseUrl = urlFor(imageRef);

// Generate srcset entries
const srcsetEntries = breakpoints
	.map((w) => `${baseUrl.width(w).auto('format').url()} ${w}w`)
	.join(', ');

// The largest image for the src attribute
const src = baseUrl.width(breakpoints[breakpoints.length - 1]).auto('format').url();

// Tiny thumbnail for blur-up placeholder
const blurDataURL = blurUp ? baseUrl.width(20).quality(50).blur(200).url() : undefined;

// Resolve alt text — prefer explicit prop, then image.alt, then empty string
const resolvedAlt = Astro.props.alt ?? image.alt ?? '';

// Extract intrinsic dimensions from metadata (CLS prevention)
const intrinsicWidth = imageRef.metadata?.dimensions?.width;
const intrinsicHeight = imageRef.metadata?.dimensions?.height;

// Compute object-position from hotspot (focal point)
// Sanity hotspot.x/y are 0-1 fractions representing the center of the focal rectangle
const objectPosition = imageRef.hotspot?.x != null && imageRef.hotspot?.y != null
	? `${imageRef.hotspot.x * 100}% ${imageRef.hotspot.y * 100}%`
	: undefined;

// Build inline styles
const styles: Record<string, string> = {};
if (aspectRatio !== 'auto') {
	styles.aspectRatio = aspectRatio;
} else if (intrinsicWidth && intrinsicHeight) {
	// Use intrinsic dimensions as fallback aspect ratio
	styles.aspectRatio = `${intrinsicWidth}/${intrinsicHeight}`;
}
if (objectFit !== 'fill') {
	styles.objectFit = objectFit;
}
if (objectPosition) {
	styles.objectPosition = objectPosition;
}
if (width) {
	styles.width = typeof width === 'number' ? `${width}px` : width;
}
if (height) {
	styles.height = typeof height === 'number' ? `${height}px` : height;
}

const styleAttr = Object.entries(styles).length
	? Object.entries(styles).map(([k, v]) => `${k}: ${v}`).join('; ')
	: undefined;
---

<picture class={`sanity-image ${className}`}>
	<img
		src={src}
		srcset={srcsetEntries}
		sizes={sizes ?? "(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw"}
		alt={resolvedAlt}
		loading={loading}
		fetchpriority={fetchpriority}
		decoding="async"
		{...styleAttr ? { style: styleAttr } : {}}
		{...imgProps}
		{...blurDataURL ? { 'data-blur-up': blurDataURL } : {}}
	/>
</picture>

<style is:inline>
	.sanity-image {
		display: block;
		overflow: hidden;
	}

	.sanity-image img {
		width: 100%;
		height: 100%;
		display: block;
		transition: opacity 0.3s ease;
	}

	/* Blur-up placeholder */
	.sanity-image img[data-blur-up] {
		background-image: url(attr(data-blur-up));
		background-size: cover;
		background-position: center;
		background-repeat: no-repeat;
	}
</style>