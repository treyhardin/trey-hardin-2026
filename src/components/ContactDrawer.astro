---
// Contact drawer: slides from right, contains contact links
---

<div class="contact-drawer-overlay" id="contactDrawerOverlay">
	<div class="contact-drawer" role="dialog" aria-modal="true" aria-label="Contact">
		<div class="contact-drawer-header">
			<h2 class="contact-drawer-title">Get in Touch</h2>
			<button class="contact-drawer-close" aria-label="Close contact drawer">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<line x1="18" y1="6" x2="6" y2="18" />
					<line x1="6" y1="6" x2="18" y2="18" />
				</svg>
			</button>
		</div>

		<div class="contact-drawer-content">
			<a href="mailto:hello@treyhardin.com" class="contact-item">
				<svg class="contact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
					<rect x="2" y="4" width="20" height="16" rx="2" />
					<path d="M22 4L12 13 2 4" />
				</svg>
				<div class="contact-item-text">
					<span class="contact-item-label">Email</span>
					<span class="contact-item-value">hello@treyhardin.com</span>
				</div>
			</a>

			<a href="https://linkedin.com/in/treyhardin" target="_blank" rel="noopener noreferrer" class="contact-item">
				<svg class="contact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
					<path d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-4 0v7h-4v-7a6 6 0 016-6z" />
					<rect x="2" y="9" width="4" height="12" />
					<circle cx="4" cy="4" r="2" />
				</svg>
				<div class="contact-item-text">
					<span class="contact-item-label">LinkedIn</span>
					<span class="contact-item-value">/in/treyhardin</span>
				</div>
			</a>

			<a href="https://x.com/treyhardin" target="_blank" rel="noopener noreferrer" class="contact-item">
				<svg class="contact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
					<path d="M4 4l16 16M20 4L4 20" />
				</svg>
				<div class="contact-item-text">
					<span class="contact-item-label">Twitter / X</span>
					<span class="contact-item-value">@treyhardin</span>
				</div>
			</a>
		</div>
	</div>
</div>

<style>
	.contact-drawer-overlay {
		position: fixed;
		inset: 0;
		z-index: var(--z-modal);
		display: flex;
		justify-content: flex-end;
		pointer-events: none;
		background: transparent;
		transition: background var(--transition-base);
	}

	.contact-drawer-overlay.open {
		pointer-events: auto;
		background: rgba(0, 0, 0, 0.15);
	}

	.contact-drawer {
		width: min(360px, 90vw);
		height: 100%;
		background: var(--color-bg);
		border-left: var(--border-width-1) solid var(--color-border);
		padding: var(--space-6);
		overflow-y: auto;
		transform: translateX(100%);
		transition: transform var(--transition-spring);
		box-shadow: var(--shadow-elevated);
		will-change: transform;
	}

	.contact-drawer-overlay.open .contact-drawer {
		transform: translateX(0);
	}

	.contact-drawer-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: var(--space-8);
		padding-bottom: var(--space-4);
		border-bottom: var(--border-width-1) solid var(--color-border);
	}

	.contact-drawer-title {
		font-family: var(--font-heading);
		font-size: var(--font-size-h5);
		font-weight: var(--font-weight-heading);
		letter-spacing: var(--letter-spacing-heading);
	}

	.contact-drawer-close {
		background: none;
		border: none;
		color: var(--color-fg-secondary);
		cursor: pointer;
		padding: var(--space-1);
		display: grid;
		place-items: center;
		transition: color var(--transition-fast);
	}

	.contact-drawer-close:hover {
		color: var(--color-fg);
	}

	.contact-drawer-close svg {
		width: var(--space-5);
		height: var(--space-5);
	}

	.contact-drawer-content {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}

	.contact-item {
		display: flex;
		align-items: center;
		gap: var(--space-3);
		padding: var(--space-3) var(--space-4);
		text-decoration: none;
		color: var(--color-fg);
		border-radius: var(--radius-md);
		transition: background var(--transition-fast);
	}

	.contact-item:hover {
		background: var(--color-bg-secondary);
		text-decoration: none;
	}

	.contact-icon {
		width: var(--space-5);
		height: var(--space-5);
		flex-shrink: 0;
		color: var(--color-fg-secondary);
	}

	.contact-item-text {
		display: flex;
		flex-direction: column;
		gap: 0;
		line-height: 1.3;
	}

	.contact-item-label {
		font-size: var(--font-size-utility);
		font-weight: var(--font-weight-utility);
		text-transform: uppercase;
		letter-spacing: var(--letter-spacing-utility);
		color: var(--color-fg-secondary);
	}

	.contact-item-value {
		font-size: var(--font-size-body);
		font-weight: var(--font-weight-medium);
	}
</style>

<script is:inline>
	(function () {
		const overlay = document.getElementById('contactDrawerOverlay');
		const closeBtn = overlay?.querySelector('.contact-drawer-close');
		if (!overlay) return;

		function toggle(open) {
			overlay.classList.toggle('open', open);
			if (open) {
				document.body.style.overflow = 'hidden';
			} else {
				document.body.style.overflow = '';
			}
		}

		document.addEventListener('toggle-contact-drawer', (e) => {
			toggle(e.detail.open);
		});

		closeBtn?.addEventListener('click', () => {
			toggle(false);
		});

		overlay.addEventListener('click', (e) => {
			if (e.target === overlay) {
				toggle(false);
			}
		});

		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && overlay.classList.contains('open')) {
				toggle(false);
			}
		});
	})();
</script>
