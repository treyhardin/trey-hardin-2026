---
// Contact drawer: slides from right, contains a contact form
---

<div class="contact-drawer-overlay" id="contactDrawerOverlay">
	<div class="contact-drawer" role="dialog" aria-modal="true" aria-label="Contact">
		<div class="contact-drawer-header">
			<h2 class="contact-drawer-title">Get in Touch</h2>
			<button class="contact-drawer-close" aria-label="Close contact drawer">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<line x1="18" y1="6" x2="6" y2="18" />
					<line x1="6" y1="6" x2="18" y2="18" />
				</svg>
			</button>
		</div>

		<form class="contact-form" id="contactForm" method="POST" action="https://formsubmit.co/ajax/hello@treyhardin.com">
			<div class="contact-form-fields">
				<label class="contact-field" for="contactName">
					<span class="contact-field-label">Name</span>
					<input class="contact-field-input" type="text" id="contactName" name="name" required autocomplete="name" />
				</label>

				<label class="contact-field" for="contactOrg">
					<span class="contact-field-label">Organization <span class="optional">(optional)</span></span>
					<input class="contact-field-input" type="text" id="contactOrg" name="organization" autocomplete="organization" />
				</label>

				<label class="contact-field" for="contactMessage">
					<span class="contact-field-label">Message</span>
					<textarea class="contact-field-input contact-field-textarea" id="contactMessage" name="message" required rows="4"></textarea>
				</label>
			</div>

			<button class="contact-submit" type="submit">Send Message</button>
			<p class="contact-status" id="contactStatus" aria-live="polite"></p>
		</form>
	</div>
</div>

<style>
	.contact-drawer-overlay {
		position: fixed;
		inset: 0;
		z-index: var(--z-modal);
		display: flex;
		justify-content: flex-end;
		pointer-events: none;
		background: transparent;
		transition: background var(--transition-base);
	}

	.contact-drawer-overlay.open {
		pointer-events: auto;
		background: rgba(0, 0, 0, 0.15);
	}

	.contact-drawer {
		width: min(360px, 90vw);
		height: 100%;
		background: var(--color-bg);
		border-left: var(--border-width-1) solid var(--color-border);
		padding: var(--space-lg);
		overflow-y: auto;
		transform: translateX(100%);
		transition: transform var(--transition-spring);
		box-shadow: var(--shadow-elevated);
		will-change: transform;
	}

	.contact-drawer-overlay.open .contact-drawer {
		transform: translateX(0);
	}

	.contact-drawer-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: var(--space-lg);
		padding-bottom: var(--space-sm);
		border-bottom: var(--border-width-1) solid var(--color-border);
	}

	.contact-drawer-close {
		background: none;
		border: none;
		color: var(--color-fg-secondary);
		cursor: pointer;
		padding: var(--space-2xs);
		display: grid;
		place-items: center;
		transition: color var(--transition-fast);
	}

	.contact-drawer-close:hover {
		color: var(--color-fg);
	}

	.contact-drawer-close svg {
		width: var(--space-md);
		height: var(--space-md);
	}

	.contact-form {
		display: flex;
		flex-direction: column;
		gap: var(--space-md);
	}

	.contact-form-fields {
		display: flex;
		flex-direction: column;
		gap: var(--space-sm);
	}

	.contact-field {
		display: flex;
		flex-direction: column;
		gap: var(--space-2xs);
	}

	.contact-field-label {
		font-size: var(--font-size-utility);
		font-weight: var(--font-weight-utility);
		text-transform: uppercase;
		letter-spacing: var(--letter-spacing-utility);
		color: var(--color-fg-secondary);
	}

	.contact-field-label .optional {
		text-transform: none;
		letter-spacing: inherit;
		font-weight: var(--font-weight-regular);
		color: var(--color-fg-tertiary);
	}

	.contact-field-input {
		font-family: inherit;
		font-size: var(--font-size-body);
		color: var(--color-fg);
		background: var(--color-bg-secondary);
		border: var(--border-width-1) solid var(--color-border);
		border-radius: var(--radius-md);
		padding: var(--space-2xs) var(--space-xs);
		transition: border-color var(--transition-fast);
		outline: none;
	}

	.contact-field-input:focus {
		border-color: var(--color-accent);
	}

	.contact-field-textarea {
		resize: vertical;
		min-height: 120px;
		line-height: 1.5;
	}

	.contact-submit {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: var(--space-2xs) var(--space-sm);
		font-size: var(--font-size-utility);
		font-weight: var(--font-weight-utility);
		text-transform: uppercase;
		letter-spacing: var(--letter-spacing-utility);
		font-family: inherit;
		background: var(--color-fg);
		color: var(--color-bg);
		border: var(--border-width-1) solid var(--color-fg);
		border-radius: var(--radius-md);
		cursor: pointer;
		transition: background var(--transition-fast), color var(--transition-fast), transform var(--transition-fast);
		flex-shrink: 0;
	}

	.contact-submit:hover {
		background: transparent;
		color: var(--color-fg);
	}

	.contact-submit:active {
		transform: scale(0.97);
	}

	.contact-status {
		font-size: var(--font-size-body);
		text-align: center;
		min-height: var(--font-size-body);
		line-height: 1.5;
	}

	.contact-status.success {
		color: var(--color-accent);
	}

	.contact-status.error {
		color: var(--color-error, #e53e3e);
	}
</style>

<script is:inline>
	(function () {
		const overlay = document.getElementById('contactDrawerOverlay');
		const closeBtn = overlay?.querySelector('.contact-drawer-close');
		const form = document.getElementById('contactForm');
		const status = document.getElementById('contactStatus');
		if (!overlay) return;

		function toggle(open) {
			overlay.classList.toggle('open', open);
			document.querySelector('.contact-trigger')
				?.setAttribute('aria-expanded', String(open));
			if (open) {
				document.body.style.overflow = 'hidden';
			} else {
				document.body.style.overflow = '';
			}
		}

		document.addEventListener('toggle-contact-drawer', (e) => {
			toggle(e.detail.open);
		});

		closeBtn?.addEventListener('click', () => {
			toggle(false);
		});

		overlay.addEventListener('click', (e) => {
			if (e.target === overlay) {
				toggle(false);
			}
		});

		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && overlay.classList.contains('open')) {
				toggle(false);
			}
		});

		if (form && status) {
			form.addEventListener('submit', async (e) => {
				e.preventDefault();
				const btn = form.querySelector('.contact-submit');
				btn.disabled = true;
				btn.textContent = 'Sending…';
				status.textContent = '';
				status.className = 'contact-status';

				try {
					const res = await fetch(form.action, {
						method: 'POST',
						body: new FormData(form),
						headers: { Accept: 'application/json' }
					});

					if (res.ok) {
						status.textContent = 'Message sent — thanks!';
						status.className = 'contact-status success';
						form.reset();
					} else {
						status.textContent = 'Something went wrong. Try again or email hello@treyhardin.com';
						status.className = 'contact-status error';
					}
				} catch {
					status.textContent = 'Network error. Try again or email hello@treyhardin.com';
					status.className = 'contact-status error';
				} finally {
					btn.disabled = false;
					btn.textContent = 'Send Message';
				}
			});
		}
	})();
</script>
