---
import BaseLayout from '../../layouts/base.astro';
import { getAllBlogPosts } from '../../lib/sanity';
import SanityImage from '../../components/SanityImage.astro';
import { getDraftModeProps } from '../../sanity/lib/draft-mode';

const { perspectiveCookie } = getDraftModeProps(Astro.cookies);
const posts = await getAllBlogPosts(perspectiveCookie);
---

<BaseLayout>
	<section class="blog-listing">
		<header class="blog-header">
			<h1>Blog</h1>
			<p class="blog-subtitle">Writing about design, process, and things I'm working on</p>
		</header>

		<div class="blog-grid">
			{posts.map((post: any) => (
				<a href={`/blog/${post.slug}`} class="blog-card">
					{post.coverImage && (
						<div class="blog-card-image">
							<SanityImage image={post.coverImage} alt={post.title} aspectRatio="16/10" />
						</div>
					)}
					<div class="blog-card-content">
						{post.publishedAt && (
							<time class="blog-card-date" datetime={post.publishedAt}>
								{new Date(post.publishedAt).toLocaleDateString('en-US', {
									year: 'numeric',
									month: 'long',
									day: 'numeric',
								})}
							</time>
						)}
						<h2 class="blog-card-title">{post.title}</h2>
						{post.excerpt && <p class="blog-card-excerpt">{post.excerpt}</p>}
					</div>
				</a>
			))}
		</div>

		{posts.length === 0 && (
			<div class="blog-empty">
				<p>No posts yet — add some in <a href="/admin">Sanity Studio</a>.</p>
			</div>
		)}
	</section>

	<style>
		.blog-header {
			margin-bottom: var(--space-xl);
		}

		.blog-header h1 {
			font-size: var(--font-size-h2);
			font-weight: 700;
			letter-spacing: -0.02em;
			margin-bottom: var(--space-2xs);
		}

		.blog-subtitle {
			color: var(--color-fg-secondary);
			font-size: var(--font-size-lg);
		}

		.blog-grid {
			display: grid;
			grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
			gap: var(--space-lg);
		}

		.blog-card {
			text-decoration: none;
			color: inherit;
			display: flex;
			flex-direction: column;
			transition: opacity 0.2s ease;
		}

		.blog-card:hover {
			opacity: 0.7;
		}

		.blog-card-image {
			aspect-ratio: 16 / 10;
			overflow: hidden;
			background: var(--color-bg-secondary);
			border-radius: 4px;
			margin-bottom: var(--space-sm);
		}

		.blog-card-image img {
			width: 100%;
			height: 100%;
			object-fit: cover;
		}

		.blog-card-content {
			display: flex;
			flex-direction: column;
			gap: var(--space-2xs);
		}

		.blog-card-date {
			font-size: var(--font-size-sm);
			font-family: var(--font-utility);
			text-transform: uppercase;
			letter-spacing: 0.06em;
			color: var(--color-fg-secondary);
		}

		.blog-card-title {
			font-size: var(--font-size-lg);
			font-weight: 600;
			letter-spacing: -0.01em;
			line-height: 1.3;
		}

		.blog-card-excerpt {
			color: var(--color-fg-secondary);
			font-size: var(--font-size-sm);
			line-height: 1.6;
		}

		.blog-empty {
			text-align: center;
			padding: var(--space-xl) 0;
			color: var(--color-fg-secondary);
		}

		.blog-empty a {
			color: var(--color-accent);
		}
	</style>
</BaseLayout>
