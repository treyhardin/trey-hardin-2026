---
import Base from '../layouts/base.astro';
import { PortableText } from 'astro-portabletext';
import { getHomepage } from '../lib/sanity';

const homepage = await getHomepage();
---

<Base>
	<div class="constrained">
		<h1 class="hero-heading">{homepage?.headline}</h1>

		{homepage?.subheadline && (
			<p class="subheadline">{homepage.subheadline}</p>
		)}

		{homepage?.bio && (
			<PortableText value={homepage.bio} />
		)}

		{homepage?.ctaLabel && homepage?.ctaLink && (
			<a class="btn btn-primary" href={homepage.ctaLink} target="_blank" rel="noopener noreferrer">
				{homepage.ctaLabel}
			</a>
		)}
	</div>

	<style is:inline>
		.hero-heading {
			line-height: var(--line-height-tight);
			margin-bottom: var(--space-4);
		}

		.subheadline {
			color: var(--color-fg-secondary);
			margin-bottom: var(--space-16);
		}

		p {
			margin-bottom: var(--space-8);
		}
	</style>
</Base>