---
import BaseLayout from '../layouts/base.astro';
import SanityMedia from '../components/SanityMedia.astro';
import { getHomepage } from '../lib/sanity';
import { getDraftModeProps } from '../sanity/lib/draft-mode';

const { perspectiveCookie } = getDraftModeProps(Astro.cookies);
const homepage = await getHomepage(perspectiveCookie);
---

<BaseLayout>
	<section class="hero">
		{homepage?.heroMedia && (
			<SanityMedia
				media={homepage.heroMedia}
				aspectRatio="16/9"
				loading="eager"
				autoplay={true}
				muted={true}
				loop={true}
				showControls={false}
			/>
		)}
		<h1>{homepage?.headline || 'Trey Hardin'}</h1>
		<p class="hero-sub">{homepage?.subheadline}</p>
		{homepage?.bio && <p class="hero-bio">{homepage.bio}</p>}
		{homepage?.ctaLabel && homepage?.ctaLink && (
			<a href={homepage.ctaLink} class="hero-cta">{homepage.ctaLabel}</a>
		)}
	</section>

	<style>
		.hero {
			min-height: 60vh;
			display: flex;
			flex-direction: column;
			justify-content: center;
			gap: var(--space-4);
		}

		.hero-sub {
			font-size: var(--font-size-lg);
			color: var(--color-fg-secondary);
			max-width: 60ch;
		}

		.hero-bio {
			font-size: var(--font-size-body);
			color: var(--color-fg-secondary);
			max-width: 60ch;
			line-height: 1.7;
		}

		.hero-cta {
			display: inline-block;
			margin-top: var(--space-2);
			padding: var(--space-2) var(--space-5);
			background: var(--color-accent);
			color: var(--color-bg);
			text-decoration: none;
			border-radius: var(--radius-full);
			font-weight: var(--font-weight-medium);
			transition: opacity var(--transition-fast);
		}

		.hero-cta:hover {
			opacity: 0.85;
		}
	</style>
</BaseLayout>
