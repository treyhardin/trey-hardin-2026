---
import BaseLayout from '../layouts/base.astro';
import HeroSection from '../components/HeroSection.astro';
import { getHomepage } from '../lib/sanity';
import { getDraftModeProps } from '../sanity/lib/draft-mode';

const { perspectiveCookie } = getDraftModeProps(Astro.cookies);
const homepage = await getHomepage(perspectiveCookie);
---

<BaseLayout seo={homepage?.seo}>
	<HeroSection
		heading={homepage?.heroHeading}
		images={homepage?.heroImages}
	/>
</BaseLayout>
