---
import BaseLayout from '../../layouts/base.astro';
import { getCaseStudyBySlug } from '../../lib/sanity';
import { urlFor } from '../../lib/image';
import { getDraftModeProps } from '../../sanity/lib/draft-mode';

export async function getStaticPaths() {
	try {
		const { getAllCaseStudies } = await import('../../lib/sanity');
		const studies = await getAllCaseStudies();
		// GROQ returns slug as a plain string, not an object.
		// Return at least one path so Astro can generate the route even with empty content.
		const paths = (studies && studies.length) ? studies : [{ slug: '__empty__' }];
		return paths.map((study: any) => ({
			params: { slug: study.slug },
		}));
	} catch (e) {
		console.error('getStaticPaths (work) failed:', e);
		return [{ params: { slug: '__empty__' } }];
	}
}

const slug = Astro.params.slug;
const { perspectiveCookie } = getDraftModeProps(Astro.cookies);
const study = await getCaseStudyBySlug(slug, perspectiveCookie);

if (!study) {
	return Astro.response = new Response('Not found', { status: 404 });
}

// Portable Text block renderer
const HEADING_MAP: Record<string, string> = {
	h1: 'h2',
	h2: 'h3',
	h3: 'h4',
	h4: 'h5',
	h5: 'h6',
	h6: 'h6',
};

function renderBlock(block: any) {
	const tag = block.style === 'normal' || !block.style
		? 'p'
		: HEADING_MAP[block.style] ?? block.style;

	const children = block.children.map((child: any) => renderChild(child, block)).join('');

	return `<${tag} class="rt-${block.style || 'normal'}">${children}</${tag}>`;
}

function renderChild(child: any, block: any) {
	let text = child.text || '';
	const marks = child.marks || [];

	if (marks.includes('code')) {
		text = `<code>${text}</code>`;
	}
	if (marks.includes('em')) {
		text = `<em>${text}</em>`;
	}
	if (marks.includes('strong')) {
		text = `<strong>${text}</strong>`;
	}
	if (marks.includes('strike_through')) {
		text = `<del>${text}</del>`;
	}
	if (marks.includes('link')) {
		const linkMarks = block.markDefs?.filter((m: any) => m._type === 'link');
		const linkIndex = marks.filter(m => m !== 'link').length;
		const href = linkMarks?.[Math.min(linkIndex, linkMarks.length - 1)]?.href || '#';
		text = `<a href="${href}" target="_blank" rel="noopener">${text}</a>`;
	}

	return text;
}

function renderBody(body: any[]) {
	let html = '';
	let i = 0;

	while (i < body.length) {
		const block = body[i];

		if (block._type === 'image') {
			html += `<figure class="rt-image"><img src="${urlFor(block).width(1200).auto('format').url()}" alt="${block.alt || ''}" /></figure>`;
			i++;
			continue;
		}

		if (block._type === 'block' && block.children) {
			if (block.listItem) {
				const listType = block.listItem === 'number' ? 'ol' : 'ul';
				html += `<${listType} class="rt-${listType}">`;

				while (i < body.length && body[i]._type === 'block' && body[i].listItem === block.listItem) {
					const item = body[i];
					const children = item.children.map((child: any) => {
						let text = child.text || '';
						const marks = child.marks || [];
						if (marks.includes('code')) text = `<code>${text}</code>`;
						if (marks.includes('em')) text = `<em>${text}</em>`;
						if (marks.includes('strong')) text = `<strong>${text}</strong>`;
						if (marks.includes('strike_through')) text = `<del>${text}</del>`;
						return text;
					}).join('');
					html += `<li>${children}</li>`;
					i++;
				}
				html += `</${listType}>`;
				continue;
			}

			if (block.children.length === 0) {
				html += `<hr class="rt-hr" />`;
				i++;
				continue;
			}

			const tag = block.style === 'normal' || !block.style ? 'p' : HEADING_MAP[block.style] || block.style;
			const children = block.children.map((child: any) => {
				let text = child.text || '';
				const marks = child.marks || [];
				if (marks.includes('code')) text = `<code>${text}</code>`;
				if (marks.includes('em')) text = `<em>${text}</em>`;
				if (marks.includes('strong')) text = `<strong>${text}</strong>`;
				if (marks.includes('strike_through')) text = `<del>${text}</del>`;
				if (marks.includes('link')) {
					const linkMarks = block.markDefs?.filter((m: any) => m._type === 'link');
					const linkIndex = marks.filter(m => m !== 'link').length;
					const href = linkMarks?.[Math.min(linkIndex, linkMarks.length - 1)]?.href || '#';
					text = `<a href="${href}" target="_blank" rel="noopener">${text}</a>`;
				}
				return text;
			}).join('');
			html += `<${tag} class="rt-${block.style || 'normal'}">${children}</${tag}>`;
			i++;
		} else {
			i++;
		}
	}
	return html;
}

const bodyHtml = renderBody(study.body || []);
---

<BaseLayout>
	<article class="case-study">
		<header class="case-study-header">
			{study.client?.name && <span class="case-study-client">{study.client.name}</span>}
			{study.year && <span class="case-study-year">{study.year}</span>}
			<h1>{study.title}</h1>
			{study.summary && <p class="case-study-summary">{study.summary}</p>}
			{study.role && <span class="case-study-role">{study.role}</span>}
			{study.coverImage && (
				<div class="case-study-cover">
					<img
						src={urlFor(study.coverImage).width(1400).auto('format').url()}
						alt={study.title}
					/>
				</div>
			)}
		</header>

		{study.body && (
			<div class="case-study-body" set:html={bodyHtml}></div>
		)}

		<div class="case-study-footer">
			<a href="/work">← Back to all work</a>
		</div>
	</article>

	<style>
		.case-study {
			padding: var(--page-margin);
		}

		.case-study-header {
			margin-bottom: var(--space-xl);
		}

		.case-study-client,
		.case-study-year {
			font-size: var(--font-size-sm);
			font-family: var(--font-utility);
			text-transform: uppercase;
			letter-spacing: 0.06em;
			color: var(--color-fg-secondary);
		margin-right: var(--space-sm);
		}

		.case-study-header h1 {
			margin-bottom: var(--space-xs);
		}

		.case-study-summary {
			color: var(--color-fg-secondary);
			max-width: 65ch;
			margin-bottom: var(--space-xs);
		}

		.case-study-role {
			font-size: var(--font-size-sm);
			font-family: var(--font-utility);
			text-transform: uppercase;
			letter-spacing: 0.04em;
			color: var(--color-fg-secondary);
		}

		.case-study-cover {
			width: 100%;
			aspect-ratio: 16 / 9;
			overflow: hidden;
			border-radius: var(--radius-md);
			background: var(--color-bg-secondary);
			margin-top: var(--space-lg);
		}

		.case-study-cover img {
			width: 100%;
			height: 100%;
			object-fit: cover;
		}

		/* ── Rich content body ── */
		:global(.case-study-body) {
			max-width: 65ch;
		}

		:global(.case-study-body > *) {
			margin-bottom: var(--space-md);
		}

		:global(.rt-h1) { font-size: var(--font-size-h1); margin-top: var(--space-2xl); margin-bottom: var(--space-xs); }
		:global(.rt-h2) { font-size: var(--font-size-h2); margin-top: var(--space-xl); margin-bottom: var(--space-xs); }
		:global(.rt-h3) { font-size: var(--font-size-h3); margin-top: var(--space-lg); margin-bottom: var(--space-2xs); }
		:global(.rt-h4) { font-size: var(--font-size-h4); margin-top: var(--space-lg); margin-bottom: var(--space-2xs); }
		:global(.rt-h5) { font-size: var(--font-size-h5); margin-top: var(--space-lg); margin-bottom: var(--space-2xs); }
		:global(.rt-h6) { font-size: var(--font-size-h6); margin-top: var(--space-lg); margin-bottom: var(--space-2xs); }

		:global(.rt-blockquote),
		:global(.case-study-body blockquote) {
			border-left: var(--border-width-1) solid var(--color-accent);
			padding-left: var(--space-md);
			margin: var(--space-lg) 0;
			font-style: italic;
			color: var(--color-fg-secondary);
		}

		:global(.rt-ul),
		:global(.rt-ol) {
			margin: var(--space-md) 0;
			padding-left: var(--space-lg);
		}

		:global(.rt-ul li) {
			list-style-type: disc;
			margin-bottom: var(--space-2xs);
			padding-left: var(--space-3xs);
		}

		:global(.rt-ol li) {
			list-style-type: decimal;
			margin-bottom: var(--space-2xs);
			padding-left: var(--space-3xs);
		}

		:global(.rt-hr) {
			border: none;
			border-top: var(--border-width-1) solid var(--color-border);
			margin: var(--space-xl) 0;
		}

		:global(.case-study-body code) {
			font-family: var(--font-mono);
			font-size: 0.875em;
			background: var(--color-bg-secondary);
			padding: 0.15em 0.4em;
			border-radius: var(--radius-sm);
		}

		:global(.rt-code) {
			font-family: var(--font-mono);
			background: var(--color-bg-secondary);
			padding: var(--space-md) var(--space-lg);
			border-radius: var(--radius-md);
			overflow-x: auto;
			margin: var(--space-lg) 0;
			border: var(--border-width-1) solid var(--color-border);
		}

		:global(.rt-code code) {
			background: none;
			padding: 0;
			border-radius: 0;
		}

		:global(.case-study-body strong) {
			font-weight: var(--font-weight-bold);
		}

		:global(.case-study-body del) {
			text-decoration: line-through;
			color: var(--color-fg-secondary);
		}

		:global(.case-study-body a) {
			color: var(--color-accent);
			text-decoration: underline;
			text-underline-offset: var(--space-3xs);
		}

		:global(.case-study-body a:hover) {
			text-decoration-thickness: 2px;
		}

		:global(.rt-image) {
			margin: var(--space-xl) 0;
			width: 100%;
			border-radius: var(--radius-md);
			overflow: hidden;
		}

		:global(.rt-image img) {
			width: 100%;
			display: block;
		}

		.case-study-footer {
			margin-top: var(--space-xl);
			padding-top: var(--space-lg);
			border-top: var(--border-width-1) solid var(--color-border);
		}

		.case-study-footer a {
			color: var(--color-accent);
			text-decoration: none;
			font-weight: 500;
		}

		.case-study-footer a:hover {
			text-decoration: underline;
		}
	</style>
</BaseLayout>
