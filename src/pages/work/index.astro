---
import BaseLayout from '../../layouts/base.astro';
import { getAllCaseStudies } from '../../lib/sanity';
import { urlFor } from '../../lib/image';
import { getDraftModeProps } from '../../sanity/lib/draft-mode';

const { perspectiveCookie } = getDraftModeProps(Astro.cookies);
const caseStudies = await getAllCaseStudies(perspectiveCookie);
---

<BaseLayout seo={{ metaTitle: 'Selected Work — Trey Hardin', metaDescription: 'Projects led from concept to launch across large-scale ecommerce.' }}>
	<section class="work-listing">
		<header class="work-header">
			<h1>Selected Work</h1>
			<p class="work-subtitle">Projects I've led from concept to launch</p>
		</header>

		<div class="work-grid">
			{caseStudies.map((study: any) => (
				<a href={`/work/${study.slug.current}`} class="work-card">
					{study.coverImage && (
						<div class="work-card-image">
							<SanityImage image={study.coverImage} aspectRatio="16/10" />
						</div>
					)}
					<div class="work-card-content">
						<div class="work-card-meta">
							{study.client?.name && <span class="work-card-client">{study.client.name}</span>}
							{study.year && <span class="work-card-year">{study.year}</span>}
						</div>
						<h3 class="work-card-title">{study.title}</h3>
						{study.summary && <p class="work-card-summary">{study.summary}</p>}
						{study.role && <span class="work-card-role">{study.role}</span>}
					</div>
				</a>
			))}
		</div>

		{caseStudies.length === 0 && (
			<div class="work-empty">
				<p>No case studies yet — add some in <a href="/admin">Sanity Studio</a>.</p>
			</div>
		)}
	</section>

	<style>
		.work-header {
			margin-bottom: var(--space-xl);
		}

		.work-header h1 {
			font-size: var(--font-size-h2);
			font-weight: 700;
			letter-spacing: -0.02em;
			margin-bottom: var(--space-2xs);
		}

		.work-subtitle {
			color: var(--color-fg-secondary);
			font-size: var(--font-size-lg);
		}

		.work-grid {
			display: grid;
			gap: var(--space-lg);
		}

		.work-card {
			text-decoration: none;
			color: inherit;
			display: grid;
			grid-template-columns: 1.2fr 1fr;
			gap: var(--space-lg);
			align-items: start;
			padding-bottom: var(--space-lg);
			border-bottom: 1px solid var(--color-border);
			transition: opacity 0.2s ease;
		}

		.work-card:first-of-type {
			padding-top: 0;
		}

		.work-card:hover {
			opacity: 0.7;
		}

		.work-card-image {
			aspect-ratio: 16 / 10;
			overflow: hidden;
			background: var(--color-bg-secondary);
			border-radius: 4px;
		}

		.work-card-image img {
			width: 100%;
			height: 100%;
			object-fit: cover;
		}

		.work-card-content {
			display: flex;
			flex-direction: column;
			gap: var(--space-xs);
		}

		.work-card-tags {
			display: flex;
			gap: var(--space-sm);
			align-items: center;
			font-size: var(--font-size-sm);
			text-transform: uppercase;
			letter-spacing: 0.06em;
			font-family: var(--font-utility);
			color: var(--color-fg-secondary);
		}

		.work-card-client::after {
			content: '·';
			margin-left: var(--space-xs);
		}

		.work-card-title {
			font-size: var(--font-size-xl);
			font-weight: 600;
			letter-spacing: -0.01em;
		}

		.work-card-summary {
			color: var(--color-fg-secondary);
			line-height: 1.6;
			max-width: 48ch;
		}

		.work-card-role {
			font-size: var(--font-size-sm);
			font-family: var(--font-utility);
			text-transform: uppercase;
			letter-spacing: 0.04em;
			color: var(--color-fg-secondary);
		}

		.work-empty {
			text-align: center;
			padding: var(--space-xl) 0;
			color: var(--color-fg-secondary);
		}

		.work-empty a {
			color: var(--color-accent);
		}

		@media (max-width: 768px) {
			.work-grid {
				grid-template-columns: 1fr;
				gap: var(--space-sm);
			}
		}
	</style>
</BaseLayout>
